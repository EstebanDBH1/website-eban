---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' en los posts; el resto de páginas son 'website'. */
  type?: 'website' | 'article';
  /** Portada del post. Si falta, se genera una tarjeta con el título (ver src/lib/og.ts). */
  image?: string;
  /** Slug del post, para pedir su tarjeta generada. */
  ogSlug?: string;
}

const { title, description = SITE.description, type = 'website', image, ogSlug } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;

/*
  Absolutas y no relativas: las redes sociales no resuelven rutas relativas al previsualizar
  un enlace. Astro.url ya trae el origen real, así que esto funciona igual en producción,
  en los previews de rama y en local.
*/
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImage = image ?? new URL(`/og/${ogSlug ?? 'home'}.png`, Astro.url.origin).href;
---

<!doctype html>
<html
  lang={SITE.lang}
  data-theme={SITE.defaultTheme}
  style={`--accent: ${SITE.accent}`}
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Tarjeta al compartir: Open Graph la leen WhatsApp, LinkedIn, Slack, Telegram… -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_ES" />

    <!-- X usa las suyas; summary_large_image es la tarjeta ancha con imagen arriba. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />
    <!--
      Antes del primer pintado: aplica el tema guardado y oculta los bloques [data-reveal]
      para que GSAP los revele (ver src/scripts/page-transitions.ts).
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('eb-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-page-enter', '');
      }
    </script>
    <ClientRouter />
    <script>
      import '@/scripts/page-transitions';
    </script>
  </head>
  <body>
    <div class="page">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: clamp(36px, 7vw, 92px) 22px 96px;
  }

  main {
    width: 100%;
    max-width: 620px;
  }
</style>
