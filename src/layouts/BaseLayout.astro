---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' en los posts; el resto de páginas son 'website'. */
  type?: 'website' | 'article';
  /** Portada del post. Si falta, se usa la tarjeta por defecto del sitio. */
  image?: string;
  /** Texto alternativo de `image`. */
  imageAlt?: string;
  /** Solo en artículos: fechas para og:article y para que Google sepa si está al día. */
  published?: Date;
  modified?: Date;
  /** Datos estructurados (JSON-LD) de la página. */
  schema?: object;
  /** Fuera de los buscadores (la 404, por ejemplo). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image,
  imageAlt,
  published,
  modified,
  schema,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const shareTitle = title ?? pageTitle;

/*
  Absolutas y no relativas: las redes sociales no resuelven rutas relativas al previsualizar
  un enlace. Astro.url ya trae el origen real, así que esto funciona igual en producción,
  en los previews de rama y en local.
*/
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImage = new URL(image ?? '/og.png', Astro.url.origin).href;
const ogImageAlt = imageAlt ?? shareTitle;
---

<!doctype html>
<html
  lang={SITE.lang}
  data-theme={SITE.defaultTheme}
  style={`--accent: ${SITE.accent}`}
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!--
      Servida desde el propio sitio (ver `fonts` en astro.config.mjs). `preload` descarga los
      woff2 a la vez que el HTML en lugar de esperar a que el CSS los descubra. Solo la
      redonda: la cursiva sale en pocos sitios y puede llegar después.
    -->
    <Font cssVariable="--font-montreal" preload={[{ style: 'normal' }]} />

    <!-- Tarjeta al compartir: Open Graph la leen WhatsApp, LinkedIn, Slack, Telegram… -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.name} />}

    <!-- X usa las suyas; summary_large_image es la tarjeta ancha con imagen arriba. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <!--
      Antes del primer pintado: aplica el tema guardado y oculta los bloques [data-reveal]
      para que GSAP los revele (ver src/scripts/page-transitions.ts).
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('eb-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-page-enter', '');
      }
    </script>
    <ClientRouter />
    <script>
      import '@/scripts/page-transitions';
    </script>
  </head>
  <body>
    <div class="page">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: clamp(36px, 7vw, 92px) 22px 96px;
  }

  main {
    width: 100%;
    max-width: 620px;
  }
</style>
