---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { SITE } from '@/config/site';
---

<header data-reveal>
  <h1 data-split="hero">{SITE.name}</h1>
  <ThemeToggle />
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
  }

  h1 {
    margin: 0;
    font-size: clamp(27px, 4.2vw, 33px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
