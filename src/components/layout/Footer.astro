---
import { SITE } from '@/config/site';
---

<footer data-reveal>
  <p data-split>{SITE.footer}</p>
</footer>

<style>
  footer {
    margin-top: 58px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  p {
    margin: 0;
  }
</style>
