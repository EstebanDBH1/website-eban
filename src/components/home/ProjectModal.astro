---
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, year, stack, status, role, href, image } = project.data;
const id = `proyecto-${project.id}`;
---

<dialog id={id} class="modal" data-project-modal aria-labelledby={`${id}-titulo`}>
  <div class="media">
    <div class="frame">
      <!--
        loading="eager" a propósito: dentro de un <dialog> cerrado (display: none) una imagen
        lazy no empieza a descargarse hasta que abres, y la cortina cuenta con que ya esté ahí.

        <img> normal y no <Image> de astro:assets: la página se renderiza en cada petición y la
        captura es remota, así que Astro tendría que descargarla cada vez solo para medirla.
        El marco ya fija el 16/9, de modo que no hay salto de maquetación.
      -->
      {
        image ? (
          <img src={image} alt={`Captura de ${name}`} loading="eager" data-modal-photo />
        ) : (
          <span class="placeholder">Captura del proyecto</span>
        )
      }
      <!-- La cortina tapa la imagen y se retira hacia abajo al abrir (ProjectList.astro). -->
      <span class="curtain" data-modal-curtain aria-hidden="true"></span>
    </div>
  </div>

  <div class="content">
    <div class="head">
      <div class="heading">
        <p class="eyebrow" data-split>Proyecto · {year}</p>
        <h3 id={`${id}-titulo`} data-split>{name}</h3>
      </div>
      <button type="button" class="close" data-close aria-label="Cerrar">✕</button>
    </div>

    <!-- data-split-group: el Markdown no se puede anotar, así que dividimos sus hijos. -->
    <div class="body" data-split-group set:html={project.rendered?.html} />

    <dl data-split-group>
      <dt>Stack</dt>
      <dd>{stack}</dd>
      <dt>Estado</dt>
      <dd>{status}</dd>
      <dt>Rol</dt>
      <dd>{role}</dd>
    </dl>

    <div class="foot">
      <a href={href} data-split>Ver el proyecto ↗</a>
      <span data-split>Esc para cerrar</span>
    </div>
  </div>
</dialog>

<style>
  .modal {
    width: min(620px, calc(100% - 40px));
    max-width: none;
    max-height: 88vh;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    /* El scroll no se escapa a la página cuando se llega al final del modal. */
    overscroll-behavior: contain;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  /* La tarjeta la anima GSAP; aquí solo queda el fondo, que es un pseudo-elemento. */
  .modal::backdrop {
    background: var(--veil, rgba(8, 7, 6, 0.62));
    opacity: 0;
  }

  .modal[open]::backdrop {
    animation: veil-in 260ms ease forwards;
  }

  .modal.is-closing::backdrop {
    animation: veil-out 200ms ease forwards;
  }

  /* Mientras se divide el texto en líneas (ver el script de ProjectList.astro). */
  .modal.is-preparing .content {
    visibility: hidden;
  }

  .media {
    padding: clamp(22px, 3.6vw, 30px) clamp(22px, 3.6vw, 30px) 0;
  }

  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: var(--tint);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .curtain {
    position: absolute;
    inset: 0;
    background: var(--bg);
    /* Se recoge hacia abajo, descubriendo la imagen de arriba hacia abajo. */
    transform-origin: bottom;
    will-change: transform;
  }

  .placeholder {
    font-size: 14px;
    color: var(--muted);
  }

  .content {
    padding: clamp(22px, 3.6vw, 30px);
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .heading {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 6px;
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  h3 {
    margin: 0;
    font-size: clamp(23px, 4vw, 27px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .close {
    flex: none;
    width: 31px;
    height: 31px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .close:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .body :global(p) {
    margin: 0;
  }

  dl {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 10px 16px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 15.5px;
  }

  dt {
    margin: 0;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .foot {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .foot a {
    font-size: 16.5px;
  }

  .foot span {
    font-size: 13px;
    color: var(--muted);
  }
</style>
