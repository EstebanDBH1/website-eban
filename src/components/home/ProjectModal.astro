---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'proyectos'>;
}

const { project } = Astro.props;
const { name, year, stack, status, role, href, image } = project.data;
const { Content } = await render(project);
const id = `proyecto-${project.id}`;
---

<dialog id={id} class="modal" data-project-modal aria-labelledby={`${id}-titulo`}>
  <div class="media">
    {
      image ? (
        <Image src={image} alt={`Captura de ${name}`} widths={[620, 1240]} sizes="(max-width: 660px) 100vw, 620px" />
      ) : (
        <span class="placeholder">Captura del proyecto</span>
      )
    }
  </div>

  <div class="content">
    <div class="head">
      <div class="heading">
        <p class="eyebrow" data-split>Proyecto · {year}</p>
        <h3 id={`${id}-titulo`} data-split>{name}</h3>
      </div>
      <button type="button" class="close" data-close aria-label="Cerrar">✕</button>
    </div>

    <!-- data-split-group: el Markdown no se puede anotar, así que dividimos sus hijos. -->
    <div class="body" data-split-group>
      <Content />
    </div>

    <dl data-split-group>
      <dt>Stack</dt>
      <dd>{stack}</dd>
      <dt>Estado</dt>
      <dd>{status}</dd>
      <dt>Rol</dt>
      <dd>{role}</dd>
    </dl>

    <div class="foot">
      <a href={href} data-split>Ver el proyecto ↗</a>
      <span data-split>Esc para cerrar</span>
    </div>
  </div>
</dialog>

<style>
  .modal {
    width: min(620px, calc(100% - 40px));
    max-width: none;
    max-height: 88vh;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .modal[open] {
    animation: card-in 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .modal[open]::backdrop {
    background: var(--veil, rgba(8, 7, 6, 0.62));
    backdrop-filter: blur(3px);
    animation: veil-in 200ms ease both;
  }

  .modal.is-closing {
    animation: card-out 180ms cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  /* Mientras se divide el texto en líneas (ver el script de ProjectList.astro). */
  .modal.is-preparing .content {
    visibility: hidden;
  }

  .modal.is-closing::backdrop {
    animation: veil-out 180ms ease forwards;
  }

  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    font-size: 14px;
    color: var(--muted);
  }

  .content {
    padding: clamp(22px, 3.6vw, 30px);
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .heading {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 6px;
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  h3 {
    margin: 0;
    font-size: clamp(23px, 4vw, 27px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .close {
    flex: none;
    width: 31px;
    height: 31px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .close:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .body :global(p) {
    margin: 0;
  }

  dl {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 10px 16px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 15.5px;
  }

  dt {
    margin: 0;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .foot {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .foot a {
    font-size: 16.5px;
  }

  .foot span {
    font-size: 13px;
    color: var(--muted);
  }
</style>
