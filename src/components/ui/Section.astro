---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section data-reveal>
  <h2 class:list={{ 'has-subtitle': subtitle }} data-split>{title}</h2>
  {subtitle && <p class="subtitle" data-split>{subtitle}</p>}
  <slot />
</section>

<style>
  section {
    margin-top: 42px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  h2.has-subtitle {
    margin-bottom: 4px;
  }

  .subtitle {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
