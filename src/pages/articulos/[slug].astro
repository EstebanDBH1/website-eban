---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPost } from '@/lib/content';

// Se renderiza en cada petición: así un artículo publicado desde /admin se ve al recargar,
// sin reconstruir el sitio. Ya no hay getStaticPaths — la ruta es dinámica.
export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getPost(slug) : null;

if (!post) return Astro.rewrite('/404');

const { title, excerpt, year, readingTime } = post.data;
---

<BaseLayout title={title} description={excerpt}>
  <article>
    <a href="/" class="back" data-reveal>← {SITE.name}</a>
    <p class="meta" data-reveal>{year} · {readingTime} de lectura</p>
    <h1 data-reveal>{title}</h1>
    <p class="excerpt" data-reveal>{excerpt}</p>

    <!-- El HTML ya viene convertido desde la colección viva (src/live.config.ts). -->
    <div class="prose" data-reveal set:html={post.rendered?.html} />

    <nav data-reveal>
      <a href="/">← Volver al inicio</a>
      <span>{SITE.name}</span>
    </nav>
  </article>
</BaseLayout>

<style>
  .back {
    font-size: 15.5px;
    text-decoration: none;
    color: var(--muted);
    display: inline-block;
    margin-bottom: 38px;
  }

  .meta {
    margin: 0 0 10px;
    font-size: 13px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(30px, 5.4vw, 40px);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  .excerpt {
    margin: 0 0 34px;
    font-size: clamp(18px, 2.6vw, 20px);
    line-height: 1.5;
    color: var(--muted);
    font-style: italic;
    text-wrap: pretty;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: clamp(17.5px, 2.4vw, 19px);
    line-height: 1.68;
    text-wrap: pretty;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(h2),
  .prose :global(h3) {
    margin: 0;
  }

  .prose :global(h2) {
    margin-top: 16px;
    font-size: 1.28em;
    font-weight: 600;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin-top: 12px;
    font-size: 1.12em;
    font-weight: 600;
    line-height: 1.3;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(blockquote) {
    padding-left: 18px;
    border-left: 2px solid var(--rule-strong);
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(img) {
    width: 100%;
    border-radius: 10px;
  }

  .prose :global(hr) {
    width: 100%;
    border: none;
    border-top: 1px solid var(--rule);
  }

  .prose :global(code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--tint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
  }

  .prose :global(pre) {
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--tint);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  nav {
    margin-top: 52px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-size: 15.5px;
    color: var(--muted);
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }
</style>
